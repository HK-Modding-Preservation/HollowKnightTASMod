{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/automation-command-v1.schema.json",
  "title": "HollowKnightTAS Automation v1 command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "argumentsBase64",
    "clientId",
    "commandId",
    "expectedMovieTick",
    "expectedRuntimeMode",
    "idempotencyKey",
    "leaseId",
    "manifestSha256",
    "requestId",
    "requiredScope",
    "schemaVersion",
    "sessionId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "requiredScope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "leaseId": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9._:-]{1,128}$"
    },
    "expectedRuntimeMode": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9._:-]{1,64}$"
    },
    "expectedMovieTick": {
      "type": "string",
      "pattern": "^$|^(0|[1-9][0-9]*)$"
    },
    "argumentsBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 900000
    }
  }
}
