{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/automation-capability-v1.schema.json",
  "title": "HollowKnightTAS Automation v1 capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "scope",
    "readOnly",
    "requiresLease",
    "availability",
    "preconditions",
    "sideEffects"
  ],
  "properties": {
    "commandId": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "readOnly": {
      "type": "boolean"
    },
    "requiresLease": {
      "type": "boolean"
    },
    "availability": {
      "enum": [
        "available",
        "experimental",
        "disabled",
        "unsupported"
      ]
    },
    "preconditions": {
      "type": "string"
    },
    "sideEffects": {
      "type": "string"
    }
  }
}
