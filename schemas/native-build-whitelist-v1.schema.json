{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/native-build-whitelist-v1.schema.json",
  "title": "HollowKnightTAS native build whitelist v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "builds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "architecture",
          "gameVersion",
          "imageFileName",
          "imageSha256",
          "assemblyCSharpSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,127}$"
          },
          "architecture": {
            "const": "x64"
          },
          "gameVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "imageFileName": {
            "const": "hollow_knight.exe"
          },
          "imageSha256": {
            "$ref": "#/$defs/sha256"
          },
          "assemblyCSharpSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
