{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/keyframe-adapter-manifest-v1.schema.json",
  "title": "HollowKnightTAS keyframe adapter manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapters",
    "schemaVersion"
  ],
  "properties": {
    "adapters": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapterId",
          "buildProfileId",
          "isRequired",
          "minimumTier",
          "schemaVersion"
        ],
        "properties": {
          "adapterId": {
            "$ref": "#/$defs/id"
          },
          "buildProfileId": {
            "$ref": "#/$defs/id"
          },
          "isRequired": {
            "type": "boolean"
          },
          "minimumTier": {
            "enum": [
              "RoomEntry",
              "RegisteredRuntime"
            ]
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
