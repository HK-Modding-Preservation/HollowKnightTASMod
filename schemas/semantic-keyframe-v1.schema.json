{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/semantic-keyframe-v1.schema.json",
  "title": "HollowKnightTAS semantic keyframe descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapterManifestSha256",
    "adapters",
    "baselineObjectSha256",
    "captureMovieTick",
    "entryGateId",
    "gameBuildSha256",
    "journalHeadSha256",
    "keyframeId",
    "manifestSha256",
    "rngStateSha256",
    "sceneEpoch",
    "sceneName",
    "schemaVersion",
    "semanticSnapshotSha256",
    "status",
    "tier"
  ],
  "properties": {
    "adapterManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapterId",
          "isRequired",
          "payloadLength",
          "payloadSha256",
          "schemaVersion"
        ],
        "properties": {
          "adapterId": {
            "$ref": "#/$defs/id"
          },
          "isRequired": {
            "type": "boolean"
          },
          "payloadLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "payloadSha256": {
            "$ref": "#/$defs/sha256"
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "baselineObjectSha256": {
      "$ref": "#/$defs/sha256"
    },
    "captureMovieTick": {
      "type": "integer",
      "minimum": 0
    },
    "entryGateId": {
      "$ref": "#/$defs/id"
    },
    "gameBuildSha256": {
      "$ref": "#/$defs/sha256"
    },
    "journalHeadSha256": {
      "$ref": "#/$defs/sha256"
    },
    "keyframeId": {
      "$ref": "#/$defs/id"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "rngStateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sceneEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "sceneName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "schemaVersion": {
      "const": 1
    },
    "semanticSnapshotSha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "Ready",
        "Incompatible",
        "UnsupportedAdapter",
        "CaptureUnsafe",
        "RestoreDesync",
        "FallbackToReplay"
      ]
    },
    "tier": {
      "enum": [
        "RoomEntry",
        "RegisteredRuntime"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
