{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/automation-state-v1.schema.json",
  "title": "HollowKnightTAS Automation v1 semantic state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "manifestSha256",
    "runtimeMode",
    "movieTick",
    "tickPhase",
    "capturedAtUtc",
    "ageMilliseconds",
    "semanticSnapshotSha256",
    "fields",
    "activeCapabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeMode": {
      "type": "string"
    },
    "movieTick": {
      "type": "integer",
      "minimum": -1
    },
    "tickPhase": {
      "type": "string"
    },
    "capturedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "ageMilliseconds": {
      "type": "integer",
      "minimum": 0
    },
    "semanticSnapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "activeCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
