{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/ipc-envelope-v1.schema.json",
  "title": "HollowKnightTAS private IPC envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sessionId",
    "sequence",
    "messageType",
    "payload"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "payload": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "maxLength": 900000
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    }
  }
}
