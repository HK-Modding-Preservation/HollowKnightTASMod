{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/semantic-snapshot-v1.schema.json",
  "title": "HollowKnightTAS semantic snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sha256",
    "values"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "canonicalHex",
          "displayValue"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "Boolean",
              "Int32",
              "Int64",
              "Float32Bits",
              "Utf8String"
            ]
          },
          "canonicalHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "displayValue": {
            "type": "string"
          }
        }
      }
    }
  }
}
