{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/movie-patch-v1.schema.json",
  "title": "HollowKnightTAS movie branch proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseMovieId",
    "candidateMovieBase64",
    "reason",
    "expectedMilestone"
  ],
  "properties": {
    "baseMovieId": {
      "type": "string",
      "pattern": "^(none|[0-9a-f]{64})$"
    },
    "candidateMovieBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 44739244
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expectedMilestone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
