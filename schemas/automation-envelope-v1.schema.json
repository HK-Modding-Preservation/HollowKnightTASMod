{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/automation-envelope-v1.schema.json",
  "title": "HollowKnightTAS Automation v1 transport envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sessionId",
    "sequence",
    "messageType",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "messageType": {
      "enum": [
        "automationHello",
        "automationHelloAck",
        "automationCommand",
        "automationResult",
        "automationEvent"
      ]
    },
    "payload": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "maxLength": 900000
      }
    }
  }
}
