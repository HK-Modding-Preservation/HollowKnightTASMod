{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/native-capability-v1.schema.json",
  "title": "HollowKnightTAS native capability descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "semanticVersion",
    "status",
    "permissions",
    "requiresNativeHost",
    "requiresBridge",
    "requiresSafeBarrier",
    "supportedOperatingSystems",
    "supportedArchitectures",
    "buildWhitelistIds",
    "maximumDurationMilliseconds",
    "maximumMemoryBytes",
    "maximumDiskBytes",
    "mutuallyExclusiveWith",
    "fallback",
    "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capabilityId": {
      "$ref": "#/$defs/id"
    },
    "semanticVersion": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "unavailable",
        "experimental-disabled",
        "experimental-enabled",
        "verified",
        "rejected-build",
        "faulted",
        "unsupported"
      ]
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ProcessQuery",
          "ProcessRead",
          "ProcessWrite",
          "SuspendThreads",
          "GraphicsApi",
          "AudioApi",
          "InProcessBridge"
        ]
      }
    },
    "requiresNativeHost": {
      "type": "boolean"
    },
    "requiresBridge": {
      "type": "boolean"
    },
    "requiresSafeBarrier": {
      "type": "boolean"
    },
    "supportedOperatingSystems": {
      "$ref": "#/$defs/idArray"
    },
    "supportedArchitectures": {
      "$ref": "#/$defs/idArray"
    },
    "buildWhitelistIds": {
      "$ref": "#/$defs/idArray"
    },
    "maximumDurationMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "maximumMemoryBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    },
    "maximumDiskBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    },
    "mutuallyExclusiveWith": {
      "$ref": "#/$defs/idArray"
    },
    "fallback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "enum": [
            "pending",
            "not-applicable"
          ]
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

