{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/companion-manifest-v1.schema.json",
  "title": "HollowKnightTAS Companion bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "rid",
    "runtimeProtocolMin",
    "runtimeProtocolMax",
    "entrypoint",
    "files",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "HollowKnightTAS.Companion" },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+$"
    },
    "rid": { "const": "win-x64" },
    "runtimeProtocolMin": { "type": "integer", "minimum": 1 },
    "runtimeProtocolMax": { "type": "integer", "minimum": 1 },
    "entrypoint": {
      "const": "Companion/win-x64/HollowKnightTAS.Companion.exe"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\:/]+(?:/[^\\\\:/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64"
    }
  }
}
