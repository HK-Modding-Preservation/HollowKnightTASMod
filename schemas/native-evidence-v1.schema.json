{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollowknighttas.local/schemas/native-evidence-v1.schema.json",
  "title": "HollowKnightTAS verified native observe evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assemblyCSharpSha256",
    "attachCyclesCompleted",
    "buildWhitelistId",
    "capabilityId",
    "capabilityVersion",
    "checkpointStatus",
    "coreAssemblySha256",
    "environmentManifestSha256",
    "evidenceVersion",
    "fallback",
    "imageSha256",
    "moduleMapSha256",
    "parentProcessVerified",
    "pssCaptureApiAvailable",
    "rawPagesPersisted",
    "requestId",
    "runtimeAssemblySha256",
    "status",
    "targetFingerprint",
    "threadSetSha256"
  ],
  "properties": {
    "assemblyCSharpSha256": {
      "$ref": "#/$defs/sha256"
    },
    "attachCyclesCompleted": {
      "const": "100"
    },
    "buildWhitelistId": {
      "const": "hk-1.5.78.11833-win64-v1"
    },
    "capabilityId": {
      "const": "native.process.observe.v1"
    },
    "capabilityVersion": {
      "const": "1"
    },
    "checkpointStatus": {
      "const": "unsupported"
    },
    "coreAssemblySha256": {
      "$ref": "#/$defs/sha256"
    },
    "environmentManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidenceVersion": {
      "const": "1"
    },
    "fallback": {
      "const": "none"
    },
    "imageSha256": {
      "$ref": "#/$defs/sha256"
    },
    "moduleMapSha256": {
      "$ref": "#/$defs/sha256"
    },
    "parentProcessVerified": {
      "const": "true"
    },
    "pssCaptureApiAvailable": {
      "enum": [
        "true",
        "false"
      ]
    },
    "rawPagesPersisted": {
      "const": "false"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "runtimeAssemblySha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "verified"
    },
    "targetFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "threadSetSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
