<UserControl x:Class="HollowKnightTAS.Companion.Controls.InfoOverlaySettingsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:HollowKnightTAS.Companion.Services">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <TextBlock Text="{ui:Text 信息显示}" FontSize="20" Margin="0,0,0,12" />
  <CheckBox Content="{ui:Text 在游戏画面中显示信息}" IsChecked="{Binding InfoSettings.Enabled}" AutomationProperties.AutomationId="HktasStudio.InfoEnabled" />
  <TextBlock Text="{ui:Text 信息显示说明}" TextWrapping="Wrap" Foreground="#A8B7C8" Margin="0,6,0,12" />
  <WrapPanel Margin="0,0,0,10">
   <TextBlock Text="{ui:Text 位置}" VerticalAlignment="Center" Margin="0,0,8,0" />
   <ComboBox Width="95" ItemsSource="{x:Static ui:InfoOverlaySettings.Anchors}" SelectedItem="{Binding InfoSettings.Anchor}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <TextBlock Text="X" Margin="10,0,4,0" VerticalAlignment="Center" /><TextBox Width="55" Text="{Binding InfoSettings.MarginX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
   <TextBlock Text="Y" Margin="10,0,4,0" VerticalAlignment="Center" /><TextBox Width="55" Text="{Binding InfoSettings.MarginY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
   <CheckBox Content="{ui:Text 调整位置}" IsChecked="{Binding InfoAdjusting}" Margin="14,0,0,0" VerticalAlignment="Center" />
  </WrapPanel>
  <WrapPanel Margin="0,0,0,12">
   <TextBlock Text="{ui:Text 字号}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox Width="45" Text="{Binding InfoSettings.FontSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
   <TextBlock Text="{ui:Text 文字颜色}" VerticalAlignment="Center" Margin="12,0,6,0" /><TextBox Width="85" Text="{Binding InfoSettings.TextColor, UpdateSourceTrigger=PropertyChanged}" />
   <TextBlock Text="{ui:Text 背景透明度}" VerticalAlignment="Center" Margin="12,0,6,0" /><Slider Width="100" Minimum="0" Maximum="1" Value="{Binding InfoSettings.BackgroundOpacity}" VerticalAlignment="Center" />
   <TextBlock Text="{ui:Text 显隐快捷键}" VerticalAlignment="Center" Margin="12,0,6,0" />
   <ComboBox Width="75" ItemsSource="{x:Static ui:InfoOverlaySettings.Hotkeys}" SelectedItem="{Binding InfoSettings.Hotkey}" />
  </WrapPanel>
  <WrapPanel Margin="0,0,0,10">
   <TextBlock Text="{ui:Text 搜索字段}" VerticalAlignment="Center" Margin="0,0,8,0" />
   <TextBox Width="110" Text="{Binding InfoSearch, UpdateSourceTrigger=PropertyChanged}" />
   <ComboBox x:Name="FieldPicker" Width="180" ItemsSource="{Binding InfoFields}" SelectedIndex="0" Margin="8,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <Button Content="{ui:Text 添加}" Click="OnAdd" />
   <Button Content="{ui:Text 恢复默认}" Click="OnReset" />
  </WrapPanel>
  <Grid MinHeight="220">
   <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
     <Button Content="{ui:Text 上移}" Click="OnUp"/><Button Content="{ui:Text 下移}" Click="OnDown"/><Button Content="{ui:Text 删除}" Click="OnRemove"/>
    </WrapPanel>
    <ListBox x:Name="ItemsList" ItemsSource="{Binding InfoSettings.Items}" SelectedIndex="0" AllowDrop="True" PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove" Drop="OnDrop" AutomationProperties.AutomationId="HktasStudio.InfoItems">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
      <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,8,0"/>
      <TextBlock Text="{ui:TextBinding FieldName}"/><TextBlock Text="{Binding Label}" Margin="8,0,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <StackPanel Grid.Column="1" Margin="18,0,0,0" DataContext="{Binding SelectedItem, ElementName=ItemsList}">
    <TextBlock Text="{ui:Text 显示名称}"/><TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="48" ToolTip="{ui:Text 留空使用默认值}" Margin="0,4,0,8"/>
    <WrapPanel Margin="0,0,0,8">
     <TextBlock Text="{ui:Text 小数位}" VerticalAlignment="Center"/><TextBox Width="45" Margin="8,0,12,0" Text="{Binding Precision, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
     <TextBlock Text="{ui:Text 单位}" VerticalAlignment="Center"/><TextBox Width="75" Margin="8,0,0,0" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/>
    </WrapPanel>
    <TextBlock Text="{ui:Text 条目颜色}"/><TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" ToolTip="{ui:Text 留空使用默认值}" Margin="0,4,0,8"/>
    <CheckBox Content="{ui:Text 冷却结束显示就绪}" IsChecked="{Binding ReadyAtZero}"/>
    <TextBlock Text="{ui:Text 信息格式说明}" TextWrapping="Wrap" Foreground="#A8B7C8" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="{ui:TextBinding InfoStatus}" TextWrapping="Wrap" Foreground="#FFAA88" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
