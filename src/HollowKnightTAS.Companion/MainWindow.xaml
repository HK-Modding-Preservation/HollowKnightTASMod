<Window x:Class="HollowKnightTAS.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HollowKnightTAS.Companion.Services"
        xmlns:controls="clr-namespace:HollowKnightTAS.Companion.Controls"
        AutomationProperties.AutomationId="HktasStudio.MainWindow"
        Style="{StaticResource {x:Type Window}}"
        Title="{ui:Text t0}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600" PreviewKeyDown="OnStudioKeyDown">
  <DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button Content="{ui:Text t1}" Command="{Binding LaunchGameCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanLaunchStandaloneGame}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="{ui:TextBinding PlayPauseLabel}" Command="{Binding TogglePauseCommand}"
              AutomationProperties.AutomationId="HktasStudio.PlayPauseButton" ToolTip="{Binding ConfiguredPause}" />
      <Button Content="{ui:Text t2}" Command="{Binding StepCommand}"
              AutomationProperties.AutomationId="HktasStudio.FrameAdvanceButton" ToolTip="{Binding ConfiguredAdvance}" />
      <Button Content="{ui:Text t3}" Command="{Binding QuitGameCommand}"
              AutomationProperties.AutomationId="HktasStudio.QuitGameButton"
              ToolTip="{ui:Text t4}" />
      <TextBlock Text="{ui:TextBinding FrameCounterText}" Margin="14,0,8,0" VerticalAlignment="Center"
                 FontFamily="Consolas" AutomationProperties.AutomationId="HktasStudio.FrameCounter" />
      <TextBlock Text="{ui:TextBinding PlaybackStateText}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
    </WrapPanel>
    <Border DockPanel.Dock="Top" Padding="8" Margin="0,0,0,6">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding IsRestorePresentationFrozen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <StackPanel><TextBlock Text="{ui:Text t5}" Margin="0,0,0,5" />
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding RestoreProgress, Mode=OneWay}" Height="5" /></StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="6" Margin="0,6,0,0" Background="{StaticResource PanelBrush}">
      <TextBlock Text="{ui:TextBinding Status}" TextWrapping="Wrap" MaxHeight="54"
                 AutomationProperties.AutomationId="HktasStudio.StatusText" />
    </Border>
    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            Padding="6"
            Margin="0,0,0,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{ui:Text t6}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Foreground="#A8B7C8" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}"

                  Margin="0,0,12,0" ><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <TextBlock Grid.Column="2"
                   Text="{ui:TextBinding RuntimeSummary}"
                   ToolTip="{ui:TextBinding RuntimeSummary}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3"
                   AutomationProperties.AutomationId="HktasStudio.RuntimeReadinessBadge"
                   Text="{ui:TextBinding RuntimeReadinessBadge}"
                   Foreground="#A8B7C8"
                   FontWeight="SemiBold"
                   Margin="12,0,12,0"
                   ToolTip="{ui:Text t7}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="4"
                   AutomationProperties.AutomationId="HktasStudio.ConnectionBadge"
                   Text="{ui:TextBinding ConnectionBadge}"
                   Foreground="{StaticResource AccentBrush}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" AutomationProperties.AutomationId="HktasStudio.MainTabs"
                SelectionChanged="OnMainTabsSelectionChanged">
      <TabItem x:Name="InputGridTab" Header="{ui:Text t8}" AutomationProperties.AutomationId="HktasStudio.InputGridTab">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,4" IsEnabled="{Binding IsInputGridInteractive}">
            <Button Content="{ui:Text t9}" Command="{Binding UndoGridCommand}" />
            <Button Content="{ui:Text t10}" Command="{Binding RedoGridCommand}" />
            <Button Content="{ui:Text t11}" Command="{Binding CopyGridCommand}" />
            <Button Content="{ui:Text t12}" Command="{Binding PasteGridCommand}" />
            <TextBlock Text="{ui:Text insertFrameCount}" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Text="{Binding GridInsertCount, UpdateSourceTrigger=PropertyChanged}" Width="64"
                     VerticalContentAlignment="Center" ToolTip="{ui:Text insertFrameCount}"
                     AutomationProperties.AutomationId="HktasStudio.InsertFrameCount" />
            <Button Content="{ui:Text t13}" Command="{Binding InsertGridCommand}" />
            <Button Content="{ui:Text t14}" Command="{Binding DeleteGridCommand}" />
          </WrapPanel>
          <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Content="{ui:Text t15}" Command="{Binding OpenMovieCommand}" IsEnabled="{Binding IsInputGridInteractive}" />
            <Button Content="{ui:Text saveSequence}" Command="{Binding SaveMovieCommand}" AutomationProperties.AutomationId="HktasStudio.SaveSequence" />
            <Button Content="{ui:Text t16}" Command="{Binding SaveMovieAsCommand}" IsEnabled="{Binding IsInputGridInteractive}" />
            <Button Content="{ui:Text t17}" Command="{Binding ApplyGridAndSeekCommand}" ToolTip="{ui:Text t18}" IsEnabled="{Binding IsInputGridInteractive}" />
            <CheckBox Content="{ui:Text t19}" IsChecked="{Binding AutoFollowGrid, Mode=TwoWay}"
                      IsEnabled="{Binding IsInputGridInteractive}"
                      AutomationProperties.AutomationId="HktasStudio.AutoFollowGrid"
                      ToolTip="{ui:Text t20}" VerticalAlignment="Center" Margin="8,0" />
            <Button Content="{ui:Text t21}" Command="{Binding StartVideoExportCommand}"
                    AutomationProperties.AutomationId="HktasStudio.ExportFullVideo" />
            <Button Content="{ui:Text t22}" Command="{Binding CancelVideoExportCommand}"
                    AutomationProperties.AutomationId="HktasStudio.CancelVideoExport" />
            <TextBlock Text="{ui:TextBinding SequenceBindingStatus}" VerticalAlignment="Center" Margin="8,0" />
          </WrapPanel>
          <controls:InputFrameGrid x:Name="InputGrid" Grid.Row="2" ItemsSource="{Binding InputRows}"
                    IsEnabled="{Binding IsInputGridInteractive}"
                    InputMethod.IsInputMethodEnabled="False"
                    AutomationProperties.AutomationId="HktasStudio.InputGrid" AutoGenerateColumns="False"
                    IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                    SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="19" FontSize="12" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                    Background="#0D131B" Foreground="#E6EDF5" RowBackground="#18202B" AlternatingRowBackground="#202A38"
                    HorizontalGridLinesBrush="#344256" VerticalGridLinesBrush="#344256"
                    PreviewMouseLeftButtonDown="OnInputGridClick" SelectionChanged="OnInputGridSelectionChanged"
                    PreviewKeyDown="OnInputGridKeyDown" PreviewMouseMove="OnInputGridMouseMove"
                    PreviewMouseLeftButtonUp="OnInputGridMouseUp" LostMouseCapture="OnInputGridLostCapture"
                    PreviewMouseWheel="OnInputGridWheel" PreviewMouseRightButtonDown="OnInputGridRightClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="" Binding="{Binding Current}" Width="28" />
              <DataGridTextColumn Header="{ui:Text t23}" Binding="{Binding Tick}" Width="75" />
              <DataGridTextColumn Header="{ui:Text t24}" Binding="{Binding FramesPerSecond}" Width="45" />
              <DataGridCheckBoxColumn Header="{ui:Text t25}" SortMemberPath="Submit" Binding="{Binding Submit, Mode=OneWay}" Width="65" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t26}" SortMemberPath="Cancel" Binding="{Binding Cancel, Mode=OneWay}" Width="65" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t27}" Binding="{Binding Left, Mode=OneWay}" SortMemberPath="Left" Width="55" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t28}" Binding="{Binding Right, Mode=OneWay}" SortMemberPath="Right" Width="55" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t29}" Binding="{Binding Up, Mode=OneWay}" SortMemberPath="Up" Width="45" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t30}" Binding="{Binding Down, Mode=OneWay}" SortMemberPath="Down" Width="55" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t31}" Binding="{Binding Jump, Mode=OneWay}" SortMemberPath="Jump" Width="55" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t32}" Binding="{Binding Attack, Mode=OneWay}" SortMemberPath="Attack" Width="60" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t33}" Binding="{Binding Dash, Mode=OneWay}" SortMemberPath="Dash" Width="55" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t34}" Binding="{Binding Cast, Mode=OneWay}" SortMemberPath="Cast" Width="50" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t35}" Binding="{Binding QuickCast, Mode=OneWay}" SortMemberPath="QuickCast" Width="80" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t36}" Binding="{Binding SuperDash, Mode=OneWay}" SortMemberPath="SuperDash" Width="85" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="{ui:Text t37}" Binding="{Binding DreamNail, Mode=OneWay}" SortMemberPath="DreamNail" Width="85" ElementStyle="{StaticResource TasGridCheckBoxStyle}" />
              <DataGridTextColumn Header="{ui:Text t38}" Binding="{Binding Axes}" SortMemberPath="Axes" Width="110" />
            </DataGrid.Columns>
          </controls:InputFrameGrid>
          <StackPanel Grid.Row="3" Margin="4,6">
            <TextBlock Text="{ui:TextBinding GridStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{ui:TextBinding VideoExportStatus}" TextTrimming="CharacterEllipsis" ToolTip="{ui:TextBinding VideoExportStatus}"
                       AutomationProperties.AutomationId="HktasStudio.VideoExportStatus" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="WorldlinesTab" Header="{ui:Text t39}" AutomationProperties.AutomationId="HktasStudio.TimelineTab">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
              <TextBlock Text="{ui:Text t40}" VerticalAlignment="Center" Margin="4" />
              <ComboBox Width="230" ItemsSource="{Binding TimelineTrees}" SelectedValuePath="Id" SelectedValue="{Binding SelectedTimelineTreeId}" ><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="{ui:Text t41}" VerticalAlignment="Center" Margin="12,4,4,4" />
              <ComboBox Width="200" ItemsSource="{Binding WorldlineLeaves}" SelectedValuePath="Id" SelectedValue="{Binding SelectedWorldlineId}" ><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,6">
              <Button Content="{ui:Text t42}" Command="{Binding SaveTimelineNodeCommand}" />
              <Button Content="{ui:Text t43}" Command="{Binding RestoreTimelineNodeCommand}" />
              <Button Content="{ui:Text t44}" Command="{Binding DeleteTimelineNodeCommand}" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6">
              <ComboBox Width="340" ItemsSource="{Binding QuickSlotLabels}" SelectedIndex="{Binding SelectedQuickSlot}" AutomationProperties.AutomationId="HktasStudio.TimelineQuickSlot"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Button Content="{ui:Text t45}" Command="{Binding BindTimelineQuickSlotCommand}"
                      AutomationProperties.AutomationId="HktasStudio.BindTimelineQuickSlot" />
              <Button Content="{ui:Text t46}" Command="{Binding LoadQuickSlotCommand}" />
            </WrapPanel>
            <TextBlock Text="{ui:TextBinding QuickSlotStatus}" Margin="4,0,4,6" TextWrapping="Wrap" />
            <Border Background="{StaticResource PanelBrush}" Padding="4" Margin="0,0,0,4">
              <StackPanel>
                <WrapPanel Margin="0,0,0,4">
                  <Button Content="{ui:Text videoRangeMarkStart}" Command="{Binding MarkVideoStartCommand}"
                          AutomationProperties.AutomationId="HktasStudio.MarkVideoStart" />
                  <Button Content="{ui:Text videoRangeMarkEnd}" Command="{Binding MarkVideoEndCommand}"
                          AutomationProperties.AutomationId="HktasStudio.MarkVideoEnd" />
                  <Button Content="{ui:Text videoRangeExport}" Command="{Binding ExportTimelineVideoCommand}"
                          AutomationProperties.AutomationId="HktasStudio.ExportTimelineVideo" />
                  <Button Content="{ui:Text videoRangeClear}" Command="{Binding ClearVideoRangeCommand}"
                          AutomationProperties.AutomationId="HktasStudio.ClearVideoRange" />
                  <Button Content="{ui:Text t22}" Command="{Binding CancelVideoExportCommand}"
                          AutomationProperties.AutomationId="HktasStudio.CancelTimelineVideoExport" />
                </WrapPanel>
                <TextBlock Text="{ui:TextBinding VideoRangeStatus}" TextTrimming="CharacterEllipsis" Margin="4,0,4,2"
                           ToolTip="{ui:Text videoRangeHelp}" AutomationProperties.AutomationId="HktasStudio.VideoRangeStatus" />
                <TextBlock Text="{ui:TextBinding VideoExportStatus}" TextTrimming="CharacterEllipsis" Margin="4,0,4,2"
                           ToolTip="{ui:TextBinding VideoExportStatus}"
                           AutomationProperties.AutomationId="HktasStudio.TimelineVideoExportStatus" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="4,0"
                             AutomationProperties.AutomationId="HktasStudio.TimelineVideoProgress">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVideoExportBusy}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{ui:TextBinding TimelineTreeStatus}" Margin="4,8" TextWrapping="Wrap" />
          <Border DockPanel.Dock="Right" Width="240" Background="{StaticResource PanelBrush}" Padding="10" Margin="8,0,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{ui:Text t48}" FontWeight="Bold" Margin="0,0,0,8" />
              <TextBlock DockPanel.Dock="Bottom" Text="{ui:TextBinding TimelineNodeDetail}" Margin="0,4,0,0" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{ui:TextBinding TimelineNodeDetail}" />
              <ListBox ItemsSource="{Binding WorldlinePath}" SelectedItem="{Binding SelectedTimelineNode}" ><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:TextBinding Label}" /></DataTemplate></ListBox.ItemTemplate></ListBox>
            </DockPanel>
          </Border>
          <controls:TimelineGraph ToolTip="{ui:Text t47}" AutomationProperties.AutomationId="HktasStudio.TimelineGraph" />
        </DockPanel>
      </TabItem>



      <TabItem x:Name="HelpTab" Header="{ui:Text t49}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
        <TextBlock Text="{ui:Text t50}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="{ui:Text t51}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="{ui:Text t52}" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="{ui:Text t53}" TextWrapping="Wrap" Margin="0,6,0,16" />
        <TextBlock Text="{ui:Text t54}" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="{ui:Text t55}" TextWrapping="Wrap" Margin="0,6,0,16" />
        <TextBlock Text="{ui:Text t56}" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="{ui:Text t57}" TextWrapping="Wrap" Margin="0,6,0,16" />
        <TextBlock Text="{ui:Text t58}" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="{ui:Text t59}" TextWrapping="Wrap" Margin="0,6,0,16" />
        <TextBlock Text="{ui:Text t60}" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="{ui:Text t61}" TextWrapping="Wrap" Margin="0,6,0,16" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="ShortcutSettingsTab" Header="{ui:Text t62}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
          <TextBlock Text="{ui:Text t63}" FontSize="20" Margin="0,0,0,16" />
          <WrapPanel Margin="0,0,0,14"><TextBlock Text="{ui:Text t64}" Width="140" VerticalAlignment="Center" /><ComboBox Width="180" ItemsSource="{Binding Languages, Source={x:Static ui:UiText.Current}}" SelectedIndex="{Binding LanguageIndex, Source={x:Static ui:UiText.Current}, Mode=TwoWay}" AutomationProperties.AutomationId="HktasStudio.Language" /></WrapPanel>
          <TextBlock Text="{Binding SettingsError, Source={x:Static ui:UiText.Current}}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,0,0,14"><TextBlock Text="{ui:Text t65}" Width="140" VerticalAlignment="Center" /><TextBlock Text="{Binding DefaultFrameRate}" Width="60" VerticalAlignment="Center" /><Button Content="{ui:Text t66}" Click="OnDefaultFrameRate" /></WrapPanel>
          <CheckBox Content="{ui:Text t67}" IsChecked="{Binding GameMouseEnabled, Mode=TwoWay}" Margin="0,0,0,10" AutomationProperties.AutomationId="HktasStudio.GameMouseEnabled" />
          <TextBlock Text="{ui:Text t68}" TextWrapping="Wrap" Margin="0,0,0,24" />
          <CheckBox Content="{ui:Text colliderOverlayEnabled}" IsChecked="{Binding ColliderOverlayEnabled, Mode=TwoWay}" Margin="0,0,0,6" AutomationProperties.AutomationId="HktasStudio.ColliderOverlayEnabled" />
          <TextBlock Text="{ui:Text colliderOverlayHelp}" TextWrapping="Wrap" Margin="0,0,0,6" />
          <TextBlock Text="{ui:TextBinding ColliderOverlayStatus}" TextWrapping="Wrap" Foreground="#FFAA88" Margin="0,0,0,18" />
          <CheckBox Content="{ui:Text globalEnabled}" IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="HktasStudio.GlobalHotkeys" />
          <TextBlock Text="{ui:Text globalHelp}" TextWrapping="Wrap" Margin="0,6,0,10" />
          <TextBlock Text="{ui:TextBinding GlobalHotkeyStatus}" TextWrapping="Wrap" Foreground="#FFAA88" />
          <TextBlock Text="{ui:Text t69}" FontSize="18" Margin="0,0,0,12" />
          <WrapPanel>
            <TextBlock Text="{ui:Text t70}" VerticalAlignment="Center" />
            <ComboBox Width="120" ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding PauseShortcut}" />
            <TextBlock Text="{ui:Text playShortcut}" VerticalAlignment="Center" />
            <ComboBox Width="120" ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding PlayShortcut}" />
            <TextBlock Text="{ui:Text t71}" VerticalAlignment="Center" />
            <ComboBox Width="120" ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding AdvanceShortcut}" />
            <Button Content="{ui:Text t72}" Command="{Binding SaveShortcutSettingsCommand}" />
            <Button Content="{ui:Text t73}" Command="{Binding ResetShortcutSettingsCommand}" />
          </WrapPanel>
          <TextBlock Text="{ui:TextBinding ShortcutSettingsStatus}" TextWrapping="Wrap" Margin="0,12" />
          <TextBlock Text="{ui:Text t74}" TextWrapping="Wrap" />
          <TextBlock Text="{ui:Text sequenceSettings}" FontSize="18" Margin="0,20,0,12" />
          <TextBlock Text="{ui:Text sequenceDirectory}" />
          <DockPanel Margin="0,6,0,12">
            <Button DockPanel.Dock="Right" Content="{ui:Text browseDirectory}" Command="{Binding BrowseSequenceDirectoryCommand}" />
            <TextBox Text="{Binding SequenceDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="HktasStudio.SequenceDirectory" />
          </DockPanel>
          <WrapPanel><TextBlock Text="{ui:Text sequenceInterval}" VerticalAlignment="Center" />
            <TextBox Width="90" Text="{Binding SequenceAutoSaveSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="HktasStudio.SequenceAutoSaveSeconds" />
            <Button Content="{ui:Text t72}" Command="{Binding SaveSequenceSettingsCommand}" />
          </WrapPanel>
          <TextBlock Text="{ui:Text sequenceSaveHelp}" TextWrapping="Wrap" Margin="0,8" />
          <TextBlock Text="{Binding SequenceSaveStatus}" TextWrapping="Wrap" />
          <TextBlock Text="{ui:TextBinding SequenceBindingStatus}" TextWrapping="Wrap" />
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
