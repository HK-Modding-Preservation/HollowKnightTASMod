<Application x:Class="HollowKnightTAS.Companion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#18202B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202A38" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5DD6C0" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="#111821" />
      <Setter Property="Foreground" Value="#EEF4FA" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="#EEF4FA" />
      <Setter Property="BorderBrush" Value="#425268" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D131B" />
      <Setter Property="Foreground" Value="#E6EDF5" />
      <Setter Property="BorderBrush" Value="#425268" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#0D131B" />
      <Setter Property="Foreground" Value="#E6EDF5" />
      <Setter Property="BorderBrush" Value="#425268" />
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="#EEF4FA" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEF4FA" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#EEF4FA" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                    BorderBrush="#425268" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
