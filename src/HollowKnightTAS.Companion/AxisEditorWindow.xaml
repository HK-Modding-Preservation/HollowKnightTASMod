<Window x:Class="HollowKnightTAS.Companion.AxisEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:HollowKnightTAS.Companion.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ui:Text t230}" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="16">
    <TextBlock x:Name="SelectionLabel" TextWrapping="Wrap" Margin="0,0,0,10" />
    <CheckBox x:Name="EnabledAxes" Content="{ui:Text t231}" />
    <WrapPanel Margin="0,12">
      <TextBlock Text="{ui:Text t236}" VerticalAlignment="Center" />
      <TextBox x:Name="AxisX" Width="120" />
      <TextBlock Text="{ui:Text t237}" VerticalAlignment="Center" />
      <TextBox x:Name="AxisY" Width="120" />
    </WrapPanel>
    <TextBlock Text="{ui:Text t232}" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" Foreground="#FFAA88" TextWrapping="Wrap" Margin="0,8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{ui:Text t233}" IsDefault="True" Click="OnApply" />
      <Button Content="{ui:Text t113}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
