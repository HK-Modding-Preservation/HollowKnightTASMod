<Window x:Class="HollowKnightTAS.Companion.AxisEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analog Input 模拟轴" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="16">
    <TextBlock x:Name="SelectionLabel" TextWrapping="Wrap" Margin="0,0,0,10" />
    <CheckBox x:Name="EnabledAxes" Content="使用模拟轴（需先清除选区方向键）" />
    <WrapPanel Margin="0,12">
      <TextBlock Text="X " VerticalAlignment="Center" />
      <TextBox x:Name="AxisX" Width="120" />
      <TextBlock Text=" Y " VerticalAlignment="Center" />
      <TextBox x:Name="AxisY" Width="120" />
    </WrapPanel>
    <TextBlock Text="范围 -10000…10000；其他动作按键保持不变。取消勾选会移除模拟轴输入。X/Y 同为 0 时，文本会省略轴字段。" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" Foreground="#FFAA88" TextWrapping="Wrap" Margin="0,8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="应用到草稿" IsDefault="True" Click="OnApply" />
      <Button Content="取消" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
