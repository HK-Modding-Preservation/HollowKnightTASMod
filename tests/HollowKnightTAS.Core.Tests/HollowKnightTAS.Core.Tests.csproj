    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Control\T24DeferredRecordingArmGate.cs"
             Link="Verification\T24DeferredRecordingArmGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\fixtures\manifest\*.json"
          Link="fixtures\manifest\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\input\*"
          Link="fixtures\input\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\ledger\*.jsonl"
          Link="fixtures\ledger\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\movie\**\*"
          Link="fixtures\movie\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\state\*"
          Link="fixtures\state\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\routes\*"
          Link="fixtures\routes\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\verification\**\*"
          Link="fixtures\verification\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\rng\**\*"
          Link="fixtures\rng\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\automation\**\*"
          Link="fixtures\automation\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
