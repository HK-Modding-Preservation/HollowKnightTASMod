    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HollowKnightTAS.Core\HollowKnightTAS.Core.csproj" />
    <ProjectReference Include="..\..\src\HollowKnightTAS.Cli\HollowKnightTAS.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Media\FfmpegVideoEncoder.cs" Link="Media\FfmpegVideoEncoder.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Ipc\NativeNamedPipeServer.cs" Link="Ipc\NativeNamedPipeServer.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Ipc\WindowsCurrentUserSid.cs" Link="Ipc\WindowsCurrentUserSid.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Ipc\PausedWindowExitShortcut.cs"
             Link="Ipc\PausedWindowExitShortcut.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Rng\IsolatedRandomStream.cs" Link="Rng\IsolatedRandomStream.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\ReplaySave\ColdReplayPrefixPolicy.cs"
             Link="ReplaySave\ColdReplayPrefixPolicy.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Inspector\WatchJsonLinesExporter.cs"
             Link="Inspector\WatchJsonLinesExporter.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.ReferenceObserver\ReferenceObserverOptions.cs" Link="ReferenceObserverOptions.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Settings\TasGlobalSettings.cs"
             Link="Settings\TasGlobalSettings.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.ClockPayload\DoublePhaseCorrection.cs"
             Link="Verification\DoublePhaseCorrection.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.ClockPayload\RecordingClockCalibrationPolicy.cs"
             Link="Verification\RecordingClockCalibrationPolicy.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.ClockPayload\SceneRngSeedDerivation.cs"
