<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HollowKnightTAS.Companion.Tests</AssemblyName>
    <RootNamespace>HollowKnightTAS.Companion.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Media\VideoInfoOverlay.cs" Link="Media\VideoInfoOverlay.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Media\FfmpegVideoEncoder.cs" Link="Media\FfmpegVideoEncoder.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Ipc\NativeNamedPipeServer.cs" Link="Media\NativeNamedPipeServer.cs" />
    <Compile Include="..\..\src\HollowKnightTAS.Runtime\Ipc\WindowsCurrentUserSid.cs" Link="Media\WindowsCurrentUserSid.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HollowKnightTAS.Core\HollowKnightTAS.Core.csproj" />
    <ProjectReference Include="..\..\src\HollowKnightTAS.Companion\HollowKnightTAS.Companion.csproj" />
    <ProjectReference Include="..\..\src\HollowKnightTAS.Automation.Client\HollowKnightTAS.Automation.Client.csproj" />
    <ProjectReference Include="..\..\src\HollowKnightTAS.AgentBridge\HollowKnightTAS.AgentBridge.csproj" />
    <ProjectReference Include="..\..\src\HollowKnightTAS.Cli\HollowKnightTAS.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\HollowKnightTAS.Companion\App.xaml"
          Link="fixtures\studio-theme.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\movie\golden\actions-v1.canonical.hktas"
          Link="fixtures\actions-v1.canonical.hktas"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\movie\invalid\unknown-action.hktas"
          Link="fixtures\unknown-action.hktas"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
